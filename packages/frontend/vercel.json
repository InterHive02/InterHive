{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://interhive-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/stats",
      "destination": "https://interhive-backend.onrender.com/api/stats"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
