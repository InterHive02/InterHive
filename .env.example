# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=1 # Set to 1 if behind Nginx/ALB/Cloudflare, or loopback for local

# Database
# In production, use replica set URI with tls=true and authentication
MONGODB_URI=mongodb://localhost:27017/interhive

# Redis (Session blacklist, distributed rate limiting, Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Production requires high-entropy random strings >= 64 characters)
# Generate via: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-64-char-random-secret-in-production
JWT_REFRESH_SECRET=replace-with-at-least-64-char-random-refresh-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth / Firebase Authentication (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FIREBASE_PROJECT_ID=your-firebase-project-id

# SMTP (Transactional Email & OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM_NAME=InterHive Team
MAIL_FROM_EMAIL=noreply@interhive.in

# Cloudflare R2 / S3 Storage (Persistent File Storage)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=interhive-storage
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# Cloudflare (Optional)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Seeding & Admin Setup
SEED_DATABASE=false
ALLOW_SEED_IN_PRODUCTION=false
ADMIN_INITIAL_PASSWORD=replace-with-min-12-char-admin-password

# CORS (Comma-separated allowed web origins)
CORS_ORIGIN=https://interhive.in,https://www.interhive.in,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Timeouts
DEFAULT_TIMEOUT=30000
UPLOAD_TIMEOUT=60000
REPORT_TIMEOUT=45000